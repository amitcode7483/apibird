{
  "name": "rest-tester",
  "displayName": "REST Tester",
  "description": "A lightweight REST client to test API requests inside VS Code",
  "version": "0.0.1",
  "publisher": "amitcode7483",
  "repository": {
    "type": "git",
    "url": "https://github.com/amitcode7483/apibird.git"
  },
  "icon": "icon.png",
  "keywords": [
    "rest",
    "api",
    "http",
    "client",
    "postman"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "restTester.open",
        "title": "REST Tester: Open"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.3.3"
  }
}
