{
  "name": "rest-tester",
  "displayName": "apibird — REST Tester",
  "description": "A lightweight REST client to test API requests inside VS Code",
  "version": "0.0.4",
  "publisher": "amitcode7483",
  "repository": {
    "type": "git",
    "url": "https://github.com/amitcode7483/apibird.git"
  },
  "icon": "icon.png",
  "keywords": [
    "rest",
    "api",
    "http",
    "client",
    "postman"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "apibird",
          "title": "apibird",
          "icon": "resources/apibird-icon.svg"
        }
      ]
    },
    "views": {
      "apibird": [
        {
          "id": "apibird.collections",
          "name": "Collections",
          "icon": "resources/apibird-icon.svg"
        },
        {
          "id": "apibird.history",
          "name": "History",
          "icon": "resources/apibird-icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "restTester.open",
        "title": "REST Tester: Open"
      },
      {
        "command": "apibird.newCollection",
        "title": "New Collection",
        "icon": "$(add)"
      },
      {
        "command": "apibird.importCollection",
        "title": "Import Collection…",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "apibird.newFolder",
        "title": "New Folder"
      },
      {
        "command": "apibird.renameItem",
        "title": "Rename"
      },
      {
        "command": "apibird.deleteItem",
        "title": "Delete"
      },
      {
        "command": "apibird.duplicateItem",
        "title": "Duplicate"
      },
      {
        "command": "apibird.exportCollection",
        "title": "Export Collection…"
      },
      {
        "command": "apibird.selectEnvironment",
        "title": "apibird: Select Environment"
      },
      {
        "command": "apibird.manageEnvironments",
        "title": "apibird: Manage Environments"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "apibird.newCollection",
          "when": "view == apibird.collections",
          "group": "navigation"
        },
        {
          "command": "apibird.importCollection",
          "when": "view == apibird.collections",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "apibird.newFolder",
          "when": "view == apibird.collections && viewItem == collection",
          "group": "inline"
        },
        {
          "command": "apibird.exportCollection",
          "when": "view == apibird.collections && viewItem == collection"
        },
        {
          "command": "apibird.renameItem",
          "when": "view == apibird.collections && (viewItem == collection || viewItem == folder || viewItem == request)"
        },
        {
          "command": "apibird.duplicateItem",
          "when": "view == apibird.collections && (viewItem == collection || viewItem == folder || viewItem == request)"
        },
        {
          "command": "apibird.deleteItem",
          "when": "view == apibird.collections && (viewItem == collection || viewItem == folder || viewItem == request)"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.3.3"
  }
}
